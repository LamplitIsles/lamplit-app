{
  "name": "lamplit-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd packages/contracts build && bun run --cwd apps/web build",
    "check": "bun run --cwd packages/contracts build && tsc --noEmit && bun run --cwd apps/web check",
    "test": "bun run --cwd packages/contracts build && bun test tests",
    "test:browser": "bun tests/browser.mjs && bun tests/voice-browser.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:panels-browser": "bun tests/panels-browser.mjs",
    "freeze:panels": "bun tests/freeze-panels.mjs",
    "test:images-browser": "bun tests/images-browser.mjs",
    "freeze:images": "bun tests/freeze-images.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "6.0.3",
    "wrangler": "^4.146.0"
  },
  "packageManager": "bun@1.3.14"
}
