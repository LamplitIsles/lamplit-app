{
  "name": "lamplit-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd packages/contracts build && bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy globalVariable preferredLanguage baseLocale && bun run --cwd packages/contracts build && tsc --noEmit && bun run --cwd apps/web check",
    "test": "bun run --cwd packages/contracts build && bun test tests",
    "test:browser": "bun tests/browser.mjs && bun tests/composer-touch-browser.mjs",
    "test:passkey-browser": "bun tests/passkey-browser.mjs",
    "test:cfl-auth-browser": "node tests/cfl-auth-browser.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:panels-browser": "bun tests/panels-browser.mjs",
    "test:models-browser": "bun tests/models-browser.mjs",
    "test:settings-browser": "bun tests/settings-browser.mjs",
    "test:background-settings-browser": "bun tests/background-settings-browser.mjs",
    "test:images-browser": "bun tests/images-browser.mjs",
    "test:file-attachments-browser": "bun tests/file-attachments-browser.mjs",
    "test:compact-browser": "bun tests/compact-browser.mjs",
    "test:search-browser": "bun tests/search-browser.mjs",
    "test:route-lifecycle-browser": "bun tests/route-lifecycle-browser.mjs",
    "test:keet-browser": "bun tests/keet-browser.mjs",
    "prepare:keet": "bun tests/prepare-keet.mjs",
    "prepare:default": "bun tests/prepare-default.mjs",
    "test:a2ui-dom": "test -f apps/web/build/a2ui.html && bun tests/a2ui-render-dom.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "happy-dom": "20.8.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "6.0.3",
    "wrangler": "^4.146.0"
  },
  "packageManager": "bun@1.3.14"
}
