{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "svelte": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "apps/web/src/lib/paraglide/**",
    ".scratch/**",
    "bun.lock",
    "**/.svelte-check/**"
  ]
}
