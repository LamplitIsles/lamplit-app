{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/worker/**"]
}
